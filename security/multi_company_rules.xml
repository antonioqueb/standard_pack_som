<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Empaque estándar: catálogo por producto. Sin compañía = compartido. -->
        <record id="rule_standard_pack_company" model="ir.rule">
            <field name="name">Empaque estándar: multiempresa</field>
            <field name="model_id" ref="model_standard_pack"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>

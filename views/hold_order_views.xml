<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columnas de empaque estándar en las líneas de la reserva/hold -->
    <record id="view_stock_lot_hold_order_form_standard_pack" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.form.standard.pack</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="inherit_id" ref="inventory_shopping_cart.view_stock_lot_hold_order_form_manual_pricing"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='cantidad_m2'])[1]" position="before">
                <field name="product_tmpl_id" column_invisible="1"/>
                <field name="has_standard_pack" column_invisible="1"/>
                <field name="standard_pack_id" string="Empaque" optional="show"
                       readonly="not has_standard_pack"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="pack_qty" string="Pack" optional="show"
                       readonly="not standard_pack_id"/>
                <field name="qty_per_pack" string="Cant./Empaque" optional="show"/>
                <field name="pack_type_name" string="Tipo de Empaque" optional="hide"/>
            </xpath>
            <xpath expr="(//field[@name='cantidad_m2'])[2]" position="before">
                <field name="product_tmpl_id" column_invisible="1"/>
                <field name="has_standard_pack" column_invisible="1"/>
                <field name="standard_pack_id" string="Empaque" optional="show"
                       readonly="not has_standard_pack"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="pack_qty" string="Pack" optional="show"
                       readonly="not standard_pack_id"/>
                <field name="qty_per_pack" string="Cant./Empaque" optional="show"/>
                <field name="pack_type_name" string="Tipo de Empaque" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
